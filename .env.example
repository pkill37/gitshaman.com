# Frontend Environment Variables
# Copy this file to .env.local for local overrides (gitignored)

# Optional: Site URL for metadata
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: Override curated corpus fetches (`/repos/*`) to hit a remote site/bucket-backed origin
# Example: https://explorar.dev
# NEXT_PUBLIC_CURATED_CONTENT_BASE_URL=

# Direct public R2/custom-domain origin for curated corpus fetches when selecting "R2 bucket"
# Example: https://pub-<hash>.r2.dev or https://r2.explorar.dev
# NEXT_PUBLIC_R2_PUBLIC_BASE_URL=

# Optional: right-sidebar Chat, hosted by giscus (public configuration, no OAuth secret).
# Enable Discussions and install https://github.com/apps/giscus on this repository.
# Obtain the repository/category IDs from https://giscus.app, then rebuild the site.
NEXT_PUBLIC_GISCUS_REPO=pkill37/gitshaman.com
NEXT_PUBLIC_GISCUS_REPO_ID=R_kgDOQh8H3w
NEXT_PUBLIC_GISCUS_CATEGORY="Q&A"
NEXT_PUBLIC_GISCUS_CATEGORY_ID=DIC_kwDOQh8H384CzaBX
