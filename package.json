{
  "name": "gitshaman.com",
  "version": "1.0.0",
  "description": "A Git companion for exploring source code",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.22.2",
    "npm": ">=9.0.0"
  },
  "scripts": {
    "cli": "tsx packages/cli/src/cli.ts",
    "cli:build": "tsx scripts/curated-contributions.ts && tsx packages/cli/build.ts",
    "test:cli": "npm run cli:build && node --import tsx --test tests/cli*.node.ts && playwright test --config packages/cli/playwright.config.ts",
    "pretest": "npm run cli:build",
    "curated:generate": "tsx scripts/curated-contributions.ts",
    "curated:check": "tsx scripts/curated-contributions.ts --online",
    "prebuild": "npm run curated:generate",
    "prelint": "npm run curated:generate",
    "precorpus:sync": "npm run curated:generate",
    "prepare": "husky",
    "predev": "tsx scripts/curated-contributions.ts && tsx scripts/prepare-public-assets.ts --dev --sqljs",
    "dev": "next dev --turbopack --port 3000",
    "build": "tsx scripts/build.ts",
    "start": "serve -l 3000 out",
    "clean": "rm -rf repos public/repos public/sqljs public/public-stage-manifest.json out .next .eslintcache",
    "corpus:sync": "EXPLORAR_SKIP_SEMANTIC_ENRICHMENT=1 tsx scripts/download-repos.ts --depth=1",
    "corpus:semantic": "tsx scripts/prepare-compilation-databases.ts",
    "corpus:check": "tsx scripts/check-corpus-indexes.ts",
    "corpus:deploy": "tsx scripts/deploy-r2.ts",
    "guides": "tsx scripts/generate-guide-registry.ts && npm run lint:guide-prose && tsx scripts/check-guide-refs.ts && tsx scripts/validate-guides.ts",
    "lint": "npm run lint:types && npm run lint:eslint && npm run lint:prettier && npm run lint:guide-prose && npm run lint:markdown",
    "lint:types": "tsc --noEmit",
    "lint:eslint": "eslint . --cache --cache-location .eslintcache --max-warnings 0",
    "lint:prettier": "prettier --config prettier.config.mjs --check .",
    "lint:guide-prose": "tsx scripts/lint-guide-prose.ts",
    "lint:markdown": "markdownlint docs/*.md --ignore docs/_template.md",
    "fix": "npm run fix:eslint && npm run fix:prettier",
    "fix:eslint": "eslint . --fix",
    "fix:prettier": "prettier --config prettier.config.mjs --write .",
    "test": "node --import tsx --test tests/*.test.mjs tests/*.node.ts && playwright test --project=chromium --project=firefox --project=mobile-chromium",
    "test:cli:coverage": "npm run cli:build && node --import tsx --test --experimental-test-coverage --test-coverage-include=\"packages/cli/src/**\" tests/cli*.node.ts",
    "corpus:android": "node --import tsx scripts/android-workspace.ts"
  },
  "dependencies": {
    "@dagrejs/dagre": "^3.1.1",
    "@giscus/react": "^3.1.0",
    "@monaco-editor/react": "^4.7.0",
    "fast-xml-parser": "^5.11.2",
    "gray-matter": "^4.0.3",
    "html2canvas": "^1.4.1",
    "js-yaml": "^4.3.2",
    "marked": "^18.0.13",
    "mermaid": "^12.0.0",
    "new-github-issue-url": "^1.1.0",
    "next": "^16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sql.js": "^1.14.2"
  },
  "overrides": {
    "dompurify": "3.4.17",
    "sharp": "0.35.5",
    "serve": {
      "compression": "1.8.2"
    },
    "markdownlint-cli": {
      "js-yaml": "5.5.0",
      "smol-toml": "1.9.1"
    },
    "micromark-extension-math": {
      "katex": "0.18.2"
    }
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@next/env": "16.4.0",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.5.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "better-sqlite3": "^12.11.1",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.2",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "ignore": "^5.3.2",
    "markdownlint-cli": "^0.49.0",
    "mdast-util-from-markdown": "^2.0.3",
    "mdast-util-gfm": "^3.1.0",
    "micromark-extension-gfm": "^3.0.0",
    "monaco-editor": "^0.53.0",
    "prettier": "^3.9.6",
    "raw-loader": "^4.0.2",
    "serve": "^14.2.6",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "write-good": "^1.0.8"
  },
  "allowScripts": {
    "better-sqlite3@12.11.1": true,
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true,
    "unrs-resolver@1.12.2": true
  }
}
