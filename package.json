{
  "name": "gitshaman.com",
  "version": "1.0.0",
  "description": "A Git companion for exploring source code",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.22.2",
    "npm": ">=9.0.0"
  },
  "scripts": {
    "prepare": "husky",
    "predev": "tsx scripts/prepare-public-assets.ts --dev --sqljs",
    "dev": "next dev --turbopack --port 3000",
    "build": "tsx scripts/build.ts",
    "start": "serve -l 3000 out -c",
    "deploy": "npm run build && tsx scripts/deploy-r2.ts",
    "clean": "rm -rf repos public/repos public/sqljs public/public-stage-manifest.json out .next .eslintcache",
    "corpus:sync": "EXPLORAR_SKIP_SEMANTIC_ENRICHMENT=1 tsx scripts/download-repos.ts --depth=1",
    "corpus:check-indexes": "tsx scripts/check-corpus-indexes.ts",
    "corpus:prepare-compilation-databases": "tsx scripts/prepare-compilation-databases.ts",
    "guides:generate": "tsx scripts/generate-guide-registry.ts",
    "guides:refs": "tsx scripts/check-guide-refs.ts",
    "guides:validate": "npm run guides:generate && npm run lint:markdown && npm run lint:guide-prose && tsx scripts/validate-guides.ts && npm run guides:refs",
    "lint": "npm run lint:types && npm run lint:eslint && npm run lint:prettier && npm run lint:guide-prose && npm run lint:markdown",
    "lint:types": "tsc --noEmit",
    "lint:eslint": "eslint . --cache --cache-location .eslintcache --max-warnings 0",
    "lint:prettier": "prettier --config prettier.config.mjs --check .",
    "lint:markdown": "markdownlint docs/*.md --ignore docs/_template.md",
    "lint:guide-prose": "tsx scripts/lint-guide-prose.ts",
    "fix": "npm run fix:eslint && npm run fix:prettier",
    "fix:eslint": "eslint . --fix",
    "fix:prettier": "prettier --config prettier.config.mjs --write .",
    "pretest": "node --import tsx --test tests/*.test.mjs tests/*.node.ts && tsx scripts/prepare-public-assets.ts",
    "test": "playwright test && playwright show-report out/playwright-report"
  },
  "dependencies": {
    "@dagrejs/dagre": "^3.1.1",
    "@giscus/react": "^3.1.0",
    "@monaco-editor/react": "^4.7.0",
    "gray-matter": "^4.0.3",
    "html2canvas": "^1.4.1",
    "marked": "^18.0.13",
    "mermaid": "^12.0.0",
    "new-github-issue-url": "^1.1.0",
    "next": "^16.3.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sql.js": "^1.14.2"
  },
  "overrides": {
    "dompurify": "3.4.12",
    "sharp": "0.35.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@dagrejs/dagre": "^3.1.1",
    "@monaco-editor/react": "^4.7.0",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.5.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "better-sqlite3": "^12.11.1",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.5",
    "eslint-config-prettier": "^10.1.8",
    "gray-matter": "^4.0.3",
    "html2canvas": "^1.4.1",
    "husky": "^9.1.7",
    "markdownlint-cli": "^0.49.1",
    "marked": "^18.0.13",
    "mdast-util-from-markdown": "^2.0.3",
    "mdast-util-gfm": "^3.1.0",
    "micromark-extension-gfm": "^3.0.0",
    "monaco-editor": "^0.53.0",
    "new-github-issue-url": "^1.1.0",
    "next": "^16.3.5",
    "prettier": "^3.9.6",
    "raw-loader": "^4.0.2",
    "serve": "^14.2.6",
    "sql.js": "^1.14.2",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "write-good": "^1.0.8"
  },
  "allowScripts": {
    "better-sqlite3@12.11.1": true,
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true,
    "unrs-resolver@1.12.2": true
  }
}
